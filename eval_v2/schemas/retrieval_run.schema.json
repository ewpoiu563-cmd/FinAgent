{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinAgent Eval v2 retrieval run",
  "type": "object",
  "required": ["query_id", "relevant", "retrieved"],
  "properties": {
    "query_id": {"type": "string", "minLength": 1},
    "relevant": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_group", "retrieval_unit_id", "relevance"],
        "properties": {
          "evidence_group": {"type": "string"},
          "retrieval_unit_id": {"type": "string"},
          "relevance": {"type": "integer", "minimum": 1, "maximum": 3}
        }
      }
    },
    "retrieved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["retrieval_unit_id", "score"],
        "properties": {
          "retrieval_unit_id": {"type": "string"},
          "score": {"type": "number"}
        }
      }
    }
  }
}
