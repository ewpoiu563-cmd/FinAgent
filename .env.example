# LLM: BASE_URL should not include /chat/completions; config.py appends it.
LLM_MODEL=qwen3-max
BASE_URL=https://your-llm-provider.example/v1
API_KEY=

# Optional: document embeddings and reranking
DASHSCOPE_API_KEY=

# Optional: public Web search
SERPER_API_KEY=

# Optional: multi-turn session persistence
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL_SECONDS=86400

# Local diagnostics. Keep disabled outside a trusted local environment.
DEBUG_UI_ENABLED=0
TRACE_ENABLED=0
TRACE_INCLUDE_CONTENT=0
TRACE_DIR=outputs/traces

# Runtime limits
LLM_TIMEOUT=60
TOTAL_TIMEOUT=600
MAX_SEARCH_QUERIES=10
MAX_FETCH_PAGES=6
